# ====================================================
# StudyAI - Staging Environment Configuration
# ====================================================

# --- Core Setup ---
NODE_ENV=production
APP_PORT=4000
FRONTEND_URL=https://staging.studyai.com

# --- Database (PostgreSQL with pgvector) ---
# For Docker Compose staging deployment
POSTGRES_USER=studyai
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:?replace-with-secret-from-external-store}
POSTGRES_DB=studyai_staging
# Connection string constructed from the above variables
DATABASE_URL=postgresql://example.invalid/studyai
DRIZZLE_DATABASE_URL=postgresql://example.invalid/studyai

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD:?replace-with-secret-from-external-store}

# --- Authentication & JWT ---
JWT_SECRET=${JWT_SECRET:?replace-with-secret-from-external-store}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET:?replace-with-secret-from-external-store}
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- OAuth (Optional for staging) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://staging.api.studyai.com/api/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=https://staging.api.studyai.com/api/auth/apple/callback

# --- AI Providers ---
# OpenRouter (Primary)
OPENROUTER_API_KEY=${OPENROUTER_API_KEY:?replace-with-secret-from-external-store}
OPENROUTER_MODEL=google/gemini-2.5-flash
# Gemini SDK Fallback
GEMINI_API_KEY=${GEMINI_API_KEY:?replace-with-secret-from-external-store}
GEMINI_MODEL=gemini-2.5-flash

# --- Stripe (Payments) ---
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY:?replace-with-secret-from-external-store}
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET:?replace-with-secret-from-external-store}
STRIPE_PRO_PRICE_ID=price_...
STRIPE_INSTITUTION_PRICE_ID=price_...

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASSWORD=${SMTP_PASSWORD:?replace-with-secret-from-external-store}
SMTP_FROM="StudyAI Staging <noreply@staging.studyai.com>"

# --- Rate Limiting ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- File Storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE=52428800