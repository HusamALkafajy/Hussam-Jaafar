# StudyAI Private Alpha VPS environment template.
# Copy to .env.staging on the VPS, restrict it to the deployment user
# (for example: chmod 600 .env.staging), and never commit the copied file.
# Values below are placeholders only. Obtain all secrets from the approved
# owner-managed providers and deployment secret store.

# Application and browser origins. APP_PORT is the NestJS setting; API_PORT is
# only the loopback host-port published by docker-compose.staging.yml.
NODE_ENV=production
APP_PORT=4000
API_PORT=4000
APP_URL=https://api.example.invalid
FRONTEND_URL=https://app.example.invalid

# Supabase PostgreSQL runtime connection. DATABASE_URL is used by Prisma at
# runtime and must be the approved pooled/runtime connection for the project.
DATABASE_URL=

# Drizzle migration connection. This must be the direct, non-pooled Supabase
# connection. It is intentionally injected only into studyai-migrate.
DRIZZLE_DATABASE_URL=

# Private Docker Redis. Use a high-entropy password. Compose supplies the
# explicit REDIS_HOST=studyai-redis and REDIS_PORT=6379 values; together with
# this injected password they form the complete production Redis contract.
# Do not put this password in a connection URL.
REDIS_PASSWORD=

# Required authentication secrets (32 characters or more).
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.invalid/api/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=https://api.example.invalid/api/auth/apple/callback
SUPER_ADMIN_EMAIL=

# AI providers. Keep unused providers blank; do not log their values.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional private-alpha services.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_INSTITUTION_PRICE_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Current source stores uploads on the mounted local validation volume. These
# are reserved for the later object-storage adapter task and are not active.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
