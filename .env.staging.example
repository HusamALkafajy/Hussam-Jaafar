# ====================================================
# StudyAI - Staging Environment Configuration
# ====================================================

# --- Core Setup ---
NODE_ENV=production
APP_PORT=4000
FRONTEND_URL=https://staging.studyai.com

# --- Database (PostgreSQL with pgvector) ---
# For Docker Compose staging deployment
POSTGRES_USER=studyai
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=studyai_staging
# Connection string constructed from the above variables
DATABASE_URL=postgresql://studyai:your_secure_postgres_password_here@localhost:5432/studyai_staging
DRIZZLE_DATABASE_URL=postgresql://studyai:your_secure_postgres_password_here@localhost:5432/studyai_staging

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here

# --- Authentication & JWT ---
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_at_least_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- OAuth (Optional for staging) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://staging.api.studyai.com/api/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=https://staging.api.studyai.com/api/auth/apple/callback

# --- AI Providers ---
# OpenRouter (Primary)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
# Gemini SDK Fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Stripe (Payments) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_INSTITUTION_PRICE_ID=price_...

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM="StudyAI Staging <noreply@staging.studyai.com>"

# --- Rate Limiting ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- File Storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE=52428800