{
  "name": "@studyai/database",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "db:generate": "node scripts/run-drizzle-kit.cjs generate",
    "db:migrate": "node scripts/run-drizzle-kit.cjs migrate",
    "db:push": "node scripts/run-drizzle-kit.cjs push",
    "db:studio": "node scripts/run-drizzle-kit.cjs studio",
    "db:check": "node scripts/run-drizzle-kit.cjs check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
