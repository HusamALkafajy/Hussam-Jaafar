# -----------------------------------------------------------
#  StudyAI — NestJS API Environment Variables
#  Copy this file to apps/api/.env and fill in your values.
#  NEVER commit apps/api/.env to version control.
# -----------------------------------------------------------

# -- Database ---------------------------------------------
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:password@localhost:5432/studyai

# -- JWT Authentication ------------------------------------
# Secret key for signing JWT tokens (required, use a long random string)
JWT_SECRET=change-me-to-a-very-long-random-secret-string-at-least-64-chars
JWT_EXPIRES_IN=7d

# -- Google OAuth (optional, for Google sign-in) ----------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# -- AI / Document Processing -----------------------------
# Provide EITHER OpenRouter OR Gemini key.
# If BOTH are missing, the service runs in MOCK MODE:
#   - Text extraction returns fake placeholder text
#   - PDF/image parsing does NOT work
#   - The app still works for UI testing with fake data

# Option A: OpenRouter (recommended - supports many models)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api   # (default, no need to set)

# Option B: Google Gemini directly
# GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXX
# GEMINI_MODEL=gemini-2.5-flash

# -- Stripe Billing (optional, for payment features) ------
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# Get this from Stripe Dashboard -> Products -> Prices
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx

# -- Application -------------------------------------------
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# -- Admin -------------------------------------------------
# This email address gets automatic ADMIN role and bypasses quotas
SUPER_ADMIN_EMAIL=admin@yourdomain.com
