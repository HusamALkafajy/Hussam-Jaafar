# -----------------------------------------------------------
# StudyAI NestJS API Environment Variables
# Copy this file to apps/api/.env and supply values from your approved local secret store.
# NEVER commit apps/api/.env to version control.
# -----------------------------------------------------------

# -- Database ---------------------------------------------
# Required for database-backed API features.
DATABASE_URL=

# -- JWT Authentication ------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# -- Redis / worker queue -----------------------------------
REDIS_URL=

# -- Durable local document storage -------------------------
STORAGE_PATH=./.storage

# -- Google OAuth (optional, for Google sign-in) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# -- Apple OAuth (optional, complete set required when enabled) --
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:4000/api/auth/apple/callback

# -- AI / Document Processing -----------------------------
# Provide an approved provider credential only when the related feature is enabled.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -- Stripe Billing (optional, for payment features) ------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# -- Application -------------------------------------------
APP_PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# -- Admin -------------------------------------------------
SUPER_ADMIN_EMAIL=
