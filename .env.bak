# ============================================dummy
# StudyAI — Environment Variables
# ============================================dummy
# Copy this file to .env and supply values from your approved local secret store.
# Do not commit the resulting .env file.

# ── App ──
NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL) ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=studyai
DATABASE_PASSWORD=dummy
DATABASE_NAME=studyai
DATABASE_URL="postgresql://studyai:dummy@localhost:5432/studyai"

# Used only by the root Compose development services.
POSTGRES_PASSWORD=dummy
TEST_POSTGRES_PASSWORD=dummydummy

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dummy

# ── JWT Authentication ──
JWT_SECRET=12345678901234567890123456789012
JWT_REFRESH_SECRET=12345678901234567890123456789012
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Google OAuth ──
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Apple OAuth ──
APPLE_CLIENT_ID=dummy
APPLE_TEAM_ID=dummy
APPLE_KEY_ID=dummy
APPLE_PRIVATE_KEY=dummy
APPLE_CALLBACK_URL=http://localhost:4000/api/auth/apple/callback

# ── AI providers ──
OPENROUTER_API_KEY=dummy
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=dummy
GEMINI_MODEL=gemini-2.5-flash

# ── File Storage ──
# "local" for development, "gcs" for Google Cloud Storage, "s3" for AWS S3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
GCS_BUCKET=dummy
GCS_PROJECT_ID=dummy
AWS_S3_BUCKET=dummy
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy

# ── Email (SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dummy
SMTP_PASSWORD=dummy
SMTP_FROM="StudyAI <noreply@studyai.com>"

# ── Stripe (Payments) ──
STRIPE_SECRET_KEY=dummy
STRIPE_PUBLISHABLE_KEY=dummy
STRIPE_WEBHOOK_SECRET=dummy
STRIPE_PRO_PRICE_ID=dummy
STRIPE_INSTITUTION_PRICE_ID=dummy

# ── Rate Limiting ──
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── File Upload Limits ──
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,image/webp

GOOGLE_CLIENT_ID=dummy-client-id-12345
GOOGLE_CLIENT_SECRET=dummy-client-secret-12345
