# Production Dockerfile for NestJS API Backend
# Multi-stage build leveraging Turborepo pruning for minimal image size.

# Stage 1: Prune monorepo
FROM node:22-alpine AS pruner
RUN apk add --no-cache libc6-compat openssl
RUN npm install -g turbo
WORKDIR /app
COPY . .
RUN turbo prune @studyai/api --docker

# Stage 2: Install dependencies
FROM node:22-alpine AS installer
RUN apk add --no-cache libc6-compat
RUN npm install -g pnpm@9.15.0
WORKDIR /app

# First copy lockfile and package.json files
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=pruner /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml

# Install dependencies
RUN pnpm install --frozen-lockfile

# Stage 3: Build the application
FROM node:22-alpine AS builder
RUN apk add --no-cache libc6-compat
RUN npm install -g pnpm@9.15.0
WORKDIR /app

COPY --from=installer /app/ .
COPY --from=pruner /app/out/full/ .
COPY turbo.json turbo.json


# Build NestJS API & dependencies (like database package)
RUN npx prisma generate --schema=packages/infrastructure/prisma/schema.prisma
RUN npx turbo build --filter=@studyai/api...

# Stage 4: Production runner
FROM node:22-alpine AS runner
RUN apk add --no-cache openssl
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

RUN addgroup --system --gid 1001 nestjs
RUN adduser --system --uid 1001 api

# Copy package lockfiles and workspace dependencies
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml

# Copy node_modules tree (pre-installed in stage 2 and built in stage 3)
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules

# Ensure upload directory exists and is owned by the app user
RUN mkdir -p /app/apps/api/uploads && chown -R api:nestjs /app/apps/api/uploads

USER api

EXPOSE 4000

# Start NestJS production build launcher
CMD ["node", "apps/api/dist/src/main.js"]
