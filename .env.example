# ============================================
# StudyAI — Environment Variables
# ============================================
# Copy this file to .env and supply values from your approved local secret store.
# Do not commit the resulting .env file.

# ── App ──
NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
INTERNAL_API_URL=http://127.0.0.1:4000

# ── Database (PostgreSQL) ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=studyai
DATABASE_PASSWORD=
DATABASE_NAME=studyai
DATABASE_URL=

# Used only by the root Compose development services.
POSTGRES_PASSWORD=
TEST_POSTGRES_PASSWORD=

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT Authentication ──
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Google OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Apple OAuth ──
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:4000/api/auth/apple/callback

# ── AI providers ──
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── File Storage ──
# "local" for development, "gcs" for Google Cloud Storage, "s3" for AWS S3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
GCS_BUCKET=
GCS_PROJECT_ID=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Email (SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="StudyAI <noreply@studyai.com>"

# ── Stripe (Payments) ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_INSTITUTION_PRICE_ID=

# ── Rate Limiting ──
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── File Upload Limits ──
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,image/webp
